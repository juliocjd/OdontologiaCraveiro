{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.odontoemcasa.com.br"
        }
      ],
      "destination": "https://odontoemcasa.com.br/$1",
      "permanent": true
    },
    { "source": "/servicos", "destination": "/servicos/", "permanent": true },
    { "source": "/atendimento-domiciliar", "destination": "/atendimento-domiciliar/", "permanent": true },
    { "source": "/atendimento-hospitalar", "destination": "/atendimento-hospitalar/", "permanent": true },
    { "source": "/idosos-e-acamados", "destination": "/idosos-e-acamados/", "permanent": true },
    { "source": "/atendimento-infantil", "destination": "/atendimento-infantil/", "permanent": true },
    { "source": "/cidades-atendidas", "destination": "/cidades-atendidas/", "permanent": true },
    { "source": "/instituicoes-e-cuidadores", "destination": "/instituicoes-e-cuidadores/", "permanent": true },
    { "source": "/escolas", "destination": "/escolas/", "permanent": true },
    { "source": "/sobre", "destination": "/sobre/", "permanent": true },
    { "source": "/faq", "destination": "/faq/", "permanent": true },
    { "source": "/limpeza-dentaria-em-casa", "destination": "/limpeza-dentaria-em-casa/", "permanent": true },
    { "source": "/higiene-bucal-para-acamados", "destination": "/higiene-bucal-para-acamados/", "permanent": true },
    { "source": "/protese-dentaria-em-casa", "destination": "/protese-dentaria-em-casa/", "permanent": true },
    { "source": "/dor-de-dente-em-casa", "destination": "/dor-de-dente-em-casa/", "permanent": true },
    { "source": "/tratamento-de-carie-em-casa", "destination": "/tratamento-de-carie-em-casa/", "permanent": true },
    { "source": "/tratamento-de-gengiva-em-casa", "destination": "/tratamento-de-gengiva-em-casa/", "permanent": true },
    { "source": "/dentista-para-paciente-em-home-care", "destination": "/dentista-para-paciente-em-home-care/", "permanent": true },
    {
      "source": "/dentista-para-paciente-com-alzheimer-e-demencia",
      "destination": "/dentista-para-paciente-com-alzheimer-e-demencia/",
      "permanent": true
    },
    { "source": "/casa", "destination": "/casa/", "permanent": true }
  ],
  "rewrites": [{ "source": "/casa/", "destination": "/api/casa" }]
}
